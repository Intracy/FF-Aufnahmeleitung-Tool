# Kopieren nach .env und ausfüllen. Die .env wird nie committet.

# live = Rundown-API pollen, replay = Fixture abspielen (Test ohne Show)
MODE=live

# Rundown-Tool
RUNDOWN_BASE_URL=https://rundown.ffverwaltung.de
RUNDOWN_TOKEN=

# Server
PORT=8080
HOST=0.0.0.0
# Optionaler Zugangsschlüssel. Gesetzt: Geräte öffnen einmal /al?key=… (wird im Gerät gespeichert).
ACCESS_KEY=

# Optional: GIF-Suche im Custom-Text (kostenloser Schlüssel: developers.giphy.com).
# Ohne Schlüssel lassen sich Giphy-Links trotzdem einfügen.
GIPHY_API_KEY=

# HTTPS (nötig für Wake Lock, Service Worker und Homescreen-App auf dem iPad)
TLS_CERT=
TLS_KEY=

# Polling
POLL_CURRENT_MS=500
POLL_FULL_MS=15000
REQUEST_TIMEOUT_MS=2500
STALE_AFTER_MS=3000

# Woher die Startzeit eines Cues kommt: auto | observed | liveSince | field:<feldname>
CUE_START_SOURCE=auto

TIME_ZONE=Europe/Berlin

# Replay
REPLAY_FILE=fixtures/ff-offline-finale-2026.json
REPLAY_SPEED=1
REPLAY_START_CUE=1
# Streuung der Dauer moderierter und offener Cues (0.15 = ±15 %)
REPLAY_JITTER=0.15
# Start x Sekunden in den Start-Cue hinein (zum Testen von Stufen/Überzug)
REPLAY_START_OFFSET=0
# 1 = Replay bleibt im Cue stehen (kein automatisches Weiterschalten)
REPLAY_HOLD=0
